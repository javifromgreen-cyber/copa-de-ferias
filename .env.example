# ---------------------------------------------------------------------
# Copa de Ferias — environment variables
# Copy this file to .env and adjust. See README.md for details.
# ---------------------------------------------------------------------

# demo (default, no external services required) | production
APP_MODE=demo

# Second, explicit gate that must ALSO be "true" before any real payment
# provider is allowed to charge a card. Keeping this false (default) means
# even production Stripe/PayPal keys will not result in real charges.
PAYMENTS_LIVE_ENABLED=false

# --- Database -----------------------------------------------------------
# Demo/local: SQLite file, zero setup.
DATABASE_URL="file:./dev.db"
# Production (Postgres / Supabase): switch provider in prisma/schema.prisma
# to "postgresql" and set e.g.
# DATABASE_URL="postgresql://user:password@host:5432/postgres"

# --- Admin auth -----------------------------------------------------------
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (optional, unused while APP_MODE=demo) ------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal (optional, unused while APP_MODE=demo) -------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Resend / transactional email (optional, unused while APP_MODE=demo) --
RESEND_API_KEY=
EMAIL_FROM="Copa de Ferias <hola@copadeferias.com>"

# --- Analytics (optional) --------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Cron protection --------------------------------------------------------
CRON_SECRET=cambia-este-secreto

# --- Real flight/hotel provider adapters (sandbox/TEST only for now) ------
# Server-side only — never read from client code. Leave empty to keep using
# the mock providers. See src/lib/providers/flights/duffel/ and
# src/lib/providers/hotels/nuitee/.
DUFFEL_ACCESS_TOKEN=
NUITEE_API_KEY=

# mock (default) | real — explicit opt-in to exercise the real Duffel/Nuitee
# sandbox adapters outside APP_MODE=production. Has no effect in production.
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock

# Hard gate for anything that could create a real (even sandbox) provider
# booking (Duffel Order / Nuitee rates/book). Never true in
# APP_MODE=production regardless of this value. Nothing in checkout calls
# these functions yet — this only matters for manual verification/tests.
ALLOW_SANDBOX_PROVIDER_BOOKING=false
