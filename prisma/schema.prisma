// Copa de Ferias — data model.
//
// Demo/local uses SQLite (zero setup). For production, switch the
// datasource below to `provider = "postgresql"` and point DATABASE_URL
// at a Postgres instance (e.g. Supabase). The schema itself is written
// to be Postgres-compatible (no SQLite-only features are used).
// See docs/DEPLOYMENT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Brand / site-wide configuration — singleton row (id = "default").
// Everything here is editable from Admin > Configuración so the brand
// name, claim, contacts, socials and legal placeholders never need to
// be hardcoded across the app.
// ---------------------------------------------------------------------
model BrandConfig {
  id           String @id @default("default")
  name         String @default("Copa de Ferias")
  shortName    String @default("CDF")
  claim        String @default("Fútbol que merece el viaje.")
  contactEmail String @default("hola@copadeferias.com")
  instagramUrl String @default("")
  facebookUrl  String @default("")
  tiktokUrl    String @default("")

  // Legal / trust placeholders — intentionally blank by default.
  // Never invent a company name, tax ID or licence number.
  legalName     String @default("")
  legalTaxId    String @default("")
  legalAddress  String @default("")
  legalLicense  String @default("")
  insuranceInfo String @default("")

  reviewsProvider String  @default("none") // none | google | trustpilot
  reviewsUrl      String  @default("")
  reviewsVisible  Boolean @default(false)

  ga4Id         String @default("")
  metaPixelId   String @default("")
  tiktokPixelId String @default("")

  notifyEmailEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
}

enum TripStatus {
  draft
  upcoming
  open
  sold_out
  completed
  archived
}

// confirmed: day and kickoff both known. time_provisional: the day itself
// is certain (matchDate) but the exact kickoff hasn't been fixed yet (e.g.
// waiting on TV scheduling) — flights can still be sold using a
// conservative kickoff-hour window (see src/lib/pricing/flightWindow.ts).
// date_provisional: not even the day is certain — no safe flight window
// can be derived, so A_TU_AIRE flight selection stays blocked until the
// date itself is confirmed. Only Event uses date_provisional in practice;
// Trip keeps using confirmed/time_provisional for its own display badge.
enum ScheduleStatus {
  confirmed
  time_provisional
  date_provisional
}

// A_TU_AIRE: self-serve, ticket(+hotel/flight) product with no coordinator,
// planning or WhatsApp group. GROUP_CDF: the original guided-group product.
// Internal identifier only — public copy always says "A TU AIRE" / "GRUPO CDF".
enum TravelMode {
  A_TU_AIRE
  GROUP_CDF
}

enum PackageType {
  TICKET_ONLY
  TICKET_HOTEL
  TICKET_HOTEL_FLIGHT
}

// Geographic/competition classification (§ catalog block) — lets the
// future public catalog query "all Europe events", "all domestic leagues
// in Europe", "all Champions League events" etc. directly from the data
// instead of hardcoded lists in frontend components. See
// src/lib/catalog/queries.ts.
enum Region {
  EUROPE
  SOUTH_AMERICA
  NORTH_AMERICA
  ASIA
  AFRICA
  OCEANIA
}

enum CompetitionType {
  DOMESTIC_LEAGUE
  DOMESTIC_CUP
  CONTINENTAL_COMPETITION
  OTHER
}

enum EventStatus {
  draft
  published
  cancelled
}

model Trip {
  id       String @id @default(cuid())
  number   Int    @unique
  slug     String @unique
  name     String // e.g. "Belgrado"
  subtitle String // e.g. "El Derbi Eterno"
  city     String
  country  String
  homeTeam String
  awayTeam String
  stadium  String

  matchDate      DateTime
  durationDays   Int      @default(3)
  durationNights Int      @default(2)

  status       TripStatus @default(draft)
  published    Boolean    @default(false)
  homeFeatured Boolean    @default(false)
  order        Int        @default(0)
  isDemo       Boolean    @default(true)

  price            Float
  currency         String    @default("EUR")
  maxSpots         Int       @default(20)
  soldSpots        Int       @default(0)
  minSpots         Int       @default(8)
  minDeadlineDate  DateTime?
  singleSupplement Float     @default(0)

  // Comma-separated Traveler field keys (birthDate,nationality,docType,
  // docNumber,docExpiry,docCountry) this trip requires from every traveler
  // during checkout, before payment — configurable per trip/provider so we
  // never force fields a given trip doesn't actually need. `sex` is asked
  // separately, only when a traveler needs a same-sex roommate match.
  requiredTravelerFields String @default("nationality,docType,docNumber,docExpiry,docCountry")

  // Whether this trip needs a shipping/billing address before payment (e.g.
  // to send the physical Pasaporte CDF pack) — a single address on the
  // booking/buyer, never one per traveler (see checkout §4).
  requiresShippingAddress Boolean @default(false)

  scheduleStatus ScheduleStatus @default(time_provisional)

  travelMode TravelMode @default(GROUP_CDF)

  // A_TU_AIRE only, from here down — GROUP_CDF trips keep using the fields
  // above unchanged (bundled ticket+hotel+host, fixed maxSpots headcount).
  maxPartySize Int @default(10) // hard cap enforced both client- and server-side

  // Comma-separated PackageType values this trip actually offers — a
  // product with no flight inventory simply never lists TICKET_HOTEL_FLIGHT.
  availablePackageTypes String @default("TICKET_ONLY,TICKET_HOTEL,TICKET_HOTEL_FLIGHT")

  // Host CDF: an optional ~3h pre-match experience tied to one Event.
  // Hidden entirely from the customer whenever hostAvailable is false —
  // never shown as "coming soon" or with placeholder pricing.
  hostAvailable   Boolean @default(false)
  hostPrice       Float   @default(0)
  hostPricingType String  @default("per_person") // per_person | flat
  hostCapacity    Int     @default(0)
  hostLanguage    String  @default("")
  hostNotes       String  @default("")

  // Guía CDF: a static PDF reference, never auto-generated.
  guideEnabled   Boolean   @default(false)
  guideTitle     String    @default("")
  guidePdfUrl    String    @default("")
  guideVersion   String    @default("")
  guideUpdatedAt DateTime?

  // Flight-timing constraints used to filter/validate flight offers against
  // this trip's Event(s) — see src/lib/pricing/flightWindow.ts.
  minimumArrivalBufferBeforeKickoffMinutes Int @default(180)
  minimumReturnBufferAfterEventMinutes     Int @default(120)

  // Pricing overrides — null/empty means "use the global OrganizationFeeConfig
  // default"; a product-level value here always wins (see §88 override rule).
  orgFeeTicketOnlyOverride       Float?
  orgFeeHotelTiersOverride       String @default("") // JSON, same shape as OrganizationFeeConfig.feeHotelTiers
  orgFeeHotelFlightTiersOverride String @default("")
  additionalMatchFeeOverride     Float?

  heroImageKey String @default("default") // maps to a generated placeholder photo treatment

  description  String @default("")
  whyWeGo      String @default("")
  localCulture String @default("")

  departureText String @default("")
  returnText    String @default("")

  hotelStars       Int     @default(3)
  hotelZone        String  @default("")
  hotelCentric     Boolean @default(true)
  hotelDescription String  @default("")

  ticketCategory String @default("")
  ticketSector   String @default("")
  ticketSeating  String @default("")

  insuranceDescription String @default("")

  coordinatorName String @default("")
  hostName        String @default("")

  cancellationPolicy  String @default("")
  importantConditions String @default("")

  whatsappUrl         String    @default("")
  whatsappAvailableAt DateTime?

  seoTitle       String @default("")
  seoDescription String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  origins      TripOrigin[]
  planningDays TripPlanningDay[]
  activities   TripActivity[]
  inclusions   TripInclusion[]
  requirements TripRequirement[]
  faqs         TripFaq[]
  leads        Lead[]
  bookings     Booking[]
  events       Event[]
}

// The classification unit for a match's league/cup/tournament — entered
// once by Admin (or a seed), then referenced by every Event that belongs
// to it. Never re-entered per Event and never hardcoded per frontend
// screen; see src/lib/catalog/knownCompetitions.ts for the seeded
// reference list and src/lib/catalog/queries.ts for the query helpers
// that replace hardcoded per-region/per-competition component lists.
model Competition {
  id   String @id @default(cuid())
  name String // e.g. "Premier League", "Champions League"

  region          Region
  // "" for competitions not tied to a single country (continental cups).
  country         String          @default("")
  competitionType CompetitionType

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, region])
}

// A Trip has one or more Events (matches). A single-match GROUP_CDF trip
// still gets exactly one Event under the hood, kept in sync with the
// legacy homeTeam/awayTeam/stadium/matchDate fields on Trip itself so the
// existing GROUP_CDF pages/flow never need to branch on Event vs Trip.
//
// Event is the primary source of truth for a match — its own
// city/country/stadium/timezone, not copied onto Trip or Competition.
// competitionId is optional so already-seeded GROUP_CDF events keep
// working unclassified; new A_TU_AIRE events are expected to set it.
model Event {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id])

  // Visible event name override, e.g. "El Derbi Eterno" — falls back to
  // "{homeTeam} vs {awayTeam}" in the UI when blank.
  name String @default("")

  homeTeam String
  awayTeam String
  stadium  String
  city     String @default("")
  country  String @default("")
  timezone String @default("Europe/Madrid")

  matchDate DateTime
  kickoff   DateTime?

  scheduleStatus ScheduleStatus @default(time_provisional)

  // Publication state — independent of scheduleStatus (which is only
  // about kickoff-timing certainty). A draft Event is never shown or
  // sellable publicly regardless of its trip's own published flag.
  status EventStatus @default(draft)

  imageKey String @default("default")

  // Exactly one Event per trip should be primaryEvent — used as the
  // trip-card/date anchor for multi-match A_TU_AIRE products.
  primaryEvent Boolean @default(true)
  order        Int     @default(0)

  ticketOffers TicketOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// P1 manual ticket inventory (no live provider API in V1) — Admin enters
// and updates these by hand per Event. costNet is the internal supplier
// cost and is never shown to the customer; the commercial price is
// costNet + the organization fee computed at quote time.
model TicketOffer {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  provider String @default("manual")
  category String @default("")
  sector   String @default("")

  costNet     Float   @default(0)
  currency    String  @default("EUR")
  stock       Int     @default(0)
  // Optional cap distinct from remaining stock (e.g. "max 4 per booking"
  // even when hundreds remain) — null means no separate cap.
  maxQuantity Int?
  active      Boolean @default(true)

  lastCheckedAt             DateTime  @default(now())
  validUntil                DateTime?
  seatingTogetherGuaranteed Boolean   @default(false)

  deliveryType  String @default("") // e.g. digital | physical | box_office
  deliveryNotes String @default("")
  restrictions  String @default("") // buyer-facing conditions (age, ID match, etc.)
  internalNotes String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------
// Organization fee / margin configuration — singleton row (id = "default"),
// same pattern as BrandConfig. Global defaults; a Trip's own orgFee*
// Override columns take priority when set. Never exposed to customers —
// only the resulting commercial total is shown at checkout.
// ---------------------------------------------------------------------
model OrganizationFeeConfig {
  id String @id @default("default")

  // TICKET_ONLY: flat fee per traveler regardless of party size.
  feeTicketOnly Float @default(49)

  // TICKET_HOTEL / TICKET_HOTEL_FLIGHT: JSON array of
  // { minParty, maxParty, feePerTraveler }, evaluated in order.
  feeHotelTiers       String @default("[{\"minParty\":1,\"maxParty\":2,\"feePerTraveler\":99},{\"minParty\":3,\"maxParty\":4,\"feePerTraveler\":94},{\"minParty\":5,\"maxParty\":6,\"feePerTraveler\":89},{\"minParty\":7,\"maxParty\":10,\"feePerTraveler\":84}]")
  feeHotelFlightTiers String @default("[{\"minParty\":1,\"maxParty\":2,\"feePerTraveler\":159},{\"minParty\":3,\"maxParty\":4,\"feePerTraveler\":149},{\"minParty\":5,\"maxParty\":6,\"feePerTraveler\":139},{\"minParty\":7,\"maxParty\":10,\"feePerTraveler\":129}]")

  additionalMatchFee Float @default(25) // per traveler, per additional match beyond the first

  // JSON map of PaymentMethod -> internal cost fraction/flat fee, e.g.
  // {"card":0,"bizum":0,"klarna":0.015,"paypal":0.034}. Internal-only cost,
  // never surfaced to the customer as a surcharge.
  paymentMethodFees String @default("{}")

  pricingBuffer          Float @default(0) // flat amount added on top of cost+fee before rounding
  minimumEstimatedProfit Float @default(0) // Admin warning threshold, per booking

  // Explicitly-labeled-as-estimate optional tax preview — never a real
  // accounting/tax engine.
  taxEstimateEnabled Boolean @default(false)
  taxEstimateRate    Float   @default(0)

  updatedAt DateTime @updatedAt
}

model TripOrigin {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city   String
  order  Int    @default(0)
}

model TripPlanningDay {
  id          String @id @default(cuid())
  tripId      String
  trip        Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title       String // e.g. "Viernes"
  description String
  icon        String @default("")
  order       Int    @default(0)
}

model TripActivity {
  id          String @id @default(cuid())
  tripId      String
  trip        Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title       String
  description String @default("")
  order       Int    @default(0)
}

model TripInclusion {
  id       String  @id @default(cuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  text     String
  included Boolean @default(true)
  order    Int     @default(0)
}

// Flat, admin-editable checklist shown in "Mi Viaje" — documentation
// reminders, dress code, meeting point, what to bring, etc. Deliberately
// simple (no categorization) so Admin never needs code to add an item.
model TripRequirement {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  text   String
  order  Int    @default(0)
}

model TripFaq {
  id       String @id @default(cuid())
  tripId   String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  question String
  answer   String
  order    Int    @default(0)
}

// Global FAQ shown on /faq (independent of any single trip).
model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  order    Int     @default(0)
  active   Boolean @default(true)
}

enum LeadType {
  notify
  waitlist
  general // "Entérate antes que nadie" home capture — not tied to one trip
}

model Lead {
  id        String   @id @default(cuid())
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type      LeadType
  name      String   @default("")
  email     String
  city      String   @default("")
  consent   Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum BookingStatus {
  pending_payment
  confirmed
  cancellation_requested
  cancelled
  refund_pending
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentProviderKind {
  demo
  stripe
  paypal
}

model Booking {
  id        String @id @default(cuid())
  reference String @unique // human-friendly booking reference

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Restrict)

  buyerFirstName String
  buyerLastName  String
  buyerEmail     String
  buyerPhone     String
  originCity     String
  billingAddress String @default("")

  travelersCount Int
  singleRooms    Int @default(0)

  totalPrice Float
  currency   String @default("EUR")

  paymentProvider PaymentProviderKind @default(demo)
  paymentStatus   PaymentStatus       @default(pending)
  bookingStatus   BookingStatus       @default(pending_payment)

  accessToken String @unique // used for "Mi Viaje" magic-link access (demo: shown directly)

  internalNotes String @default("")

  // Set by Admin only, when a specific service on this booking genuinely
  // needs one more piece of information that wasn't known/required at
  // checkout time. Empty by default — a brand-new booking must never show
  // a "missing data" banner in Mi Viaje just because it's new.
  additionalDataRequestNote String @default("")

  hasReceivedPassport Boolean @default(false)
  passportStatus      String  @default("pending") // pending | prepared | sent

  // A_TU_AIRE only — null/0 on every legacy and GROUP_CDF booking, which
  // keep using the trip-level bundled price as before.
  packageType  PackageType?
  partySize    Int?
  ticketCount  Int?
  hostSelected Boolean      @default(false)
  hostCount    Int          @default(0)

  // Frozen JSON snapshots of the hotel/flight offers and price breakdown
  // actually purchased, captured at final revalidation — so a later change
  // in mock provider data never rewrites what the customer already bought.
  hotelSelectionSnapshot  String @default("")
  flightSelectionSnapshot String @default("")
  priceBreakdownSnapshot  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  travelers      Traveler[]
  changeRequests ChangeRequest[]
  emailLogs      EmailLog[]
}

enum RoomPreference {
  share_with_group
  share_same_sex
  single
}

model Traveler {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  birthDate DateTime?

  // Origin belongs to each traveler, not the buyer — a single booking can
  // mix travelers departing from different cities (see checkout §15).
  originCity String @default("")

  roomPreference  RoomPreference @default(share_with_group)
  roomPartnerName String         @default("")

  // Data captured during checkout when the trip requires it (see
  // Trip.requiredTravelerFields) — no longer a post-purchase "Mi Viaje"
  // checklist for a new booking, though the fields remain editable there
  // for corrections.
  nationality           String    @default("")
  sex                   String    @default("")
  docType               String    @default("") // dni | passport
  docNumber             String    @default("")
  docExpiry             DateTime?
  docCountry            String    @default("")
  phone                 String    @default("")
  emergencyContactName  String    @default("")
  emergencyContactPhone String    @default("")

  // A_TU_AIRE only — tickets can be fewer than travelers (§161), so each
  // traveler tracks whether they're one of the assigned ticket-holders.
  hasTicket     Boolean @default(true)
  originAirport String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChangeRequestType {
  name_change
  important_change
  cancellation
}

enum ChangeRequestStatus {
  requested
  in_review
  approved
  rejected
  completed
}

model ChangeRequest {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type            ChangeRequestType
  description     String
  status          ChangeRequestStatus @default(requested)
  resolutionNotes String              @default("")
  cost            Float? // real cost if applicable — never invented automatically

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------
// Transactional emails — fully editable from Admin so no code change is
// needed to update copy, timing or on/off state.
// ---------------------------------------------------------------------
model EmailTemplate {
  id               String  @id @default(cuid())
  key              String  @unique // e.g. "booking_confirmed"
  name             String
  description      String  @default("")
  subject          String
  body             String // supports {{variable}} placeholders, see docs/EMAILS.md
  active           Boolean @default(false)
  // Offset in days relative to the trip's departure/return date, or null
  // for "immediate" (sent right after the triggering event, e.g. booking).
  timingDaysOffset Int?
  timingReference  String  @default("immediate") // immediate | booking_plus_1 | before_departure | after_return

  updatedAt DateTime @updatedAt
}

enum EmailMode {
  demo
  real
}

model EmailLog {
  id          String    @id @default(cuid())
  templateKey String
  to          String
  subject     String
  body        String
  mode        EmailMode @default(demo)
  sentAt      DateTime  @default(now())

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
}

// Note: admin auth uses a stateless signed cookie (see src/lib/auth/admin.ts)
// rather than a DB-backed session, so it can be checked in Next.js
// middleware (edge runtime, no Prisma access) without an extra round trip.
// Fine for a single small internal team in V1; documented upgrade path to
// Supabase Auth in docs/DEPLOYMENT.md.
