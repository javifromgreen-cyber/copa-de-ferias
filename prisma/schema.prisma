// Copa de Ferias — data model.
//
// Demo/local uses SQLite (zero setup). For production, switch the
// datasource below to `provider = "postgresql"` and point DATABASE_URL
// at a Postgres instance (e.g. Supabase). The schema itself is written
// to be Postgres-compatible (no SQLite-only features are used).
// See docs/DEPLOYMENT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Brand / site-wide configuration — singleton row (id = "default").
// Everything here is editable from Admin > Configuración so the brand
// name, claim, contacts, socials and legal placeholders never need to
// be hardcoded across the app.
// ---------------------------------------------------------------------
model BrandConfig {
  id           String @id @default("default")
  name         String @default("Copa de Ferias")
  shortName    String @default("CDF")
  claim        String @default("Fútbol que merece el viaje.")
  contactEmail String @default("hola@copadeferias.com")
  instagramUrl String @default("")
  facebookUrl  String @default("")
  tiktokUrl    String @default("")

  // Legal / trust placeholders — intentionally blank by default.
  // Never invent a company name, tax ID or licence number.
  legalName     String @default("")
  legalTaxId    String @default("")
  legalAddress  String @default("")
  legalLicense  String @default("")
  insuranceInfo String @default("")

  reviewsProvider String  @default("none") // none | google | trustpilot
  reviewsUrl      String  @default("")
  reviewsVisible  Boolean @default(false)

  ga4Id         String @default("")
  metaPixelId   String @default("")
  tiktokPixelId String @default("")

  notifyEmailEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
}

enum TripStatus {
  draft
  upcoming
  open
  sold_out
  completed
  archived
}

// confirmed: day and kickoff both known. time_provisional: the day itself
// is certain (matchDate) but the exact kickoff hasn't been fixed yet (e.g.
// waiting on TV scheduling) — flights can still be sold using a
// conservative kickoff-hour window (see src/lib/pricing/flightWindow.ts).
// date_provisional: not even the day is certain — no safe flight window
// can be derived, so A_TU_AIRE flight selection stays blocked until the
// date itself is confirmed. Only Event uses date_provisional in practice;
// Trip keeps using confirmed/time_provisional for its own display badge.
enum ScheduleStatus {
  confirmed
  time_provisional
  date_provisional
}

// A_TU_AIRE: self-serve, ticket(+hotel/flight) product with no coordinator,
// planning or WhatsApp group. GROUP_CDF: the original guided-group product.
// Internal identifier only — public copy always says "A TU AIRE" / "GRUPO CDF".
enum TravelMode {
  A_TU_AIRE
  GROUP_CDF
}

enum PackageType {
  TICKET_ONLY
  TICKET_HOTEL
  TICKET_HOTEL_FLIGHT
}

// Geographic/competition classification (§ catalog block) — lets the
// future public catalog query "all Europe events", "all domestic leagues
// in Europe", "all Champions League events" etc. directly from the data
// instead of hardcoded lists in frontend components. See
// src/lib/catalog/queries.ts.
enum Region {
  EUROPE
  SOUTH_AMERICA
  NORTH_AMERICA
  ASIA
  AFRICA
  OCEANIA
}

enum CompetitionType {
  DOMESTIC_LEAGUE
  DOMESTIC_CUP
  CONTINENTAL_COMPETITION
  OTHER
}

enum EventStatus {
  draft
  published
  cancelled
}

model Trip {
  id       String @id @default(cuid())
  number   Int    @unique
  slug     String @unique
  name     String // e.g. "Belgrado"
  subtitle String // e.g. "El Derbi Eterno"
  city     String
  country  String
  homeTeam String
  awayTeam String
  stadium  String

  matchDate      DateTime
  durationDays   Int      @default(3)
  durationNights Int      @default(2)

  status       TripStatus @default(draft)
  published    Boolean    @default(false)
  homeFeatured Boolean    @default(false)
  order        Int        @default(0)
  isDemo       Boolean    @default(true)

  price            Float
  currency         String    @default("EUR")
  maxSpots         Int       @default(20)
  soldSpots        Int       @default(0)
  minSpots         Int       @default(8)
  minDeadlineDate  DateTime?
  singleSupplement Float     @default(0)

  // Comma-separated Traveler field keys (birthDate,nationality,docType,
  // docNumber,docExpiry,docCountry) this trip requires from every traveler
  // during checkout, before payment — configurable per trip/provider so we
  // never force fields a given trip doesn't actually need. `sex` is asked
  // separately, only when a traveler needs a same-sex roommate match.
  requiredTravelerFields String @default("nationality,docType,docNumber,docExpiry,docCountry")

  // Whether this trip needs a shipping/billing address before payment (e.g.
  // to send the physical Pasaporte CDF pack) — a single address on the
  // booking/buyer, never one per traveler (see checkout §4).
  requiresShippingAddress Boolean @default(false)

  scheduleStatus ScheduleStatus @default(time_provisional)

  travelMode TravelMode @default(GROUP_CDF)

  // A_TU_AIRE only, from here down — GROUP_CDF trips keep using the fields
  // above unchanged (bundled ticket+hotel+host, fixed maxSpots headcount).
  maxPartySize Int @default(10) // hard cap enforced both client- and server-side

  // Comma-separated PackageType values this trip actually offers — a
  // product with no flight inventory simply never lists TICKET_HOTEL_FLIGHT.
  availablePackageTypes String @default("TICKET_ONLY,TICKET_HOTEL,TICKET_HOTEL_FLIGHT")

  // Host CDF: an optional ~3h pre-match experience tied to one Event.
  // Hidden entirely from the customer whenever hostAvailable is false —
  // never shown as "coming soon" or with placeholder pricing.
  hostAvailable   Boolean @default(false)
  hostPrice       Float   @default(0)
  hostPricingType String  @default("per_person") // per_person | flat
  hostCapacity    Int     @default(0)
  hostLanguage    String  @default("")
  hostNotes       String  @default("")

  // Guía CDF: a static PDF reference, never auto-generated.
  guideEnabled   Boolean   @default(false)
  guideTitle     String    @default("")
  guidePdfUrl    String    @default("")
  guideVersion   String    @default("")
  guideUpdatedAt DateTime?

  // Flight-timing constraints used to filter/validate flight offers against
  // this trip's Event(s) — see src/lib/pricing/flightWindow.ts.
  minimumArrivalBufferBeforeKickoffMinutes Int @default(180)
  minimumReturnBufferAfterEventMinutes     Int @default(120)

  // Pricing overrides — null/empty means "use the global OrganizationFeeConfig
  // default"; a product-level value here always wins (see §88 override rule).
  orgFeeTicketOnlyOverride       Float?
  orgFeeHotelTiersOverride       String @default("") // JSON, same shape as OrganizationFeeConfig.feeHotelTiers
  orgFeeHotelFlightTiersOverride String @default("")
  additionalMatchFeeOverride     Float?

  heroImageKey String @default("default") // maps to a generated placeholder photo treatment

  description  String @default("")
  whyWeGo      String @default("")
  localCulture String @default("")

  departureText String @default("")
  returnText    String @default("")

  hotelStars       Int     @default(3)
  hotelZone        String  @default("")
  hotelCentric     Boolean @default(true)
  hotelDescription String  @default("")

  ticketCategory String @default("")
  ticketSector   String @default("")
  ticketSeating  String @default("")

  insuranceDescription String @default("")

  coordinatorName String @default("")
  hostName        String @default("")

  cancellationPolicy  String @default("")
  importantConditions String @default("")

  whatsappUrl         String    @default("")
  whatsappAvailableAt DateTime?

  seoTitle       String @default("")
  seoDescription String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  origins          TripOrigin[]
  planningDays     TripPlanningDay[]
  activities       TripActivity[]
  inclusions       TripInclusion[]
  requirements     TripRequirement[]
  faqs             TripFaq[]
  leads            Lead[]
  bookings         Booking[]
  events           Event[]
  checkoutAttempts CheckoutAttempt[]
}

// The classification unit for a match's league/cup/tournament — entered
// once by Admin (or a seed), then referenced by every Event that belongs
// to it. Never re-entered per Event and never hardcoded per frontend
// screen; see src/lib/catalog/knownCompetitions.ts for the seeded
// reference list and src/lib/catalog/queries.ts for the query helpers
// that replace hardcoded per-region/per-competition component lists.
model Competition {
  id   String @id @default(cuid())
  name String // e.g. "Premier League", "Champions League"

  region          Region
  // "" for competitions not tied to a single country (continental cups).
  country         String          @default("")
  competitionType CompetitionType

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, region])
}

// A Trip has one or more Events (matches). A single-match GROUP_CDF trip
// still gets exactly one Event under the hood, kept in sync with the
// legacy homeTeam/awayTeam/stadium/matchDate fields on Trip itself so the
// existing GROUP_CDF pages/flow never need to branch on Event vs Trip.
//
// Event is the primary source of truth for a match — its own
// city/country/stadium/timezone, not copied onto Trip or Competition.
// competitionId is optional so already-seeded GROUP_CDF events keep
// working unclassified; new A_TU_AIRE events are expected to set it.
model Event {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id])

  // Visible event name override, e.g. "El Derbi Eterno" — falls back to
  // "{homeTeam} vs {awayTeam}" in the UI when blank.
  name String @default("")

  homeTeam String
  awayTeam String
  stadium  String
  city     String @default("")
  country  String @default("")
  timezone String @default("Europe/Madrid")

  matchDate DateTime
  kickoff   DateTime?

  scheduleStatus ScheduleStatus @default(time_provisional)

  // Publication state — independent of scheduleStatus (which is only
  // about kickoff-timing certainty). A draft Event is never shown or
  // sellable publicly regardless of its trip's own published flag.
  status EventStatus @default(draft)

  imageKey String @default("default")

  // Exactly one Event per trip should be primaryEvent — used as the
  // trip-card/date anchor for multi-match A_TU_AIRE products.
  primaryEvent Boolean @default(true)
  order        Int     @default(0)

  ticketOffers TicketOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// P1 manual ticket inventory (no live provider API in V1) — Admin enters
// and updates these by hand per Event. costNet is the internal supplier
// cost and is never shown to the customer; the commercial price is
// costNet + the organization fee computed at quote time.
model TicketOffer {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  provider String @default("manual")
  category String @default("")
  sector   String @default("")

  costNet     Float   @default(0)
  currency    String  @default("EUR")
  stock       Int     @default(0)
  // Optional cap distinct from remaining stock (e.g. "max 4 per booking"
  // even when hundreds remain) — null means no separate cap.
  maxQuantity Int?
  active      Boolean @default(true)

  lastCheckedAt             DateTime  @default(now())
  validUntil                DateTime?
  seatingTogetherGuaranteed Boolean   @default(false)

  deliveryType  String @default("") // e.g. digital | physical | box_office
  deliveryNotes String @default("")
  restrictions  String @default("") // buyer-facing conditions (age, ID match, etc.)
  internalNotes String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketHolds TicketHold[]
}

// ---------------------------------------------------------------------
// Organization fee / margin configuration — singleton row (id = "default"),
// same pattern as BrandConfig. Global defaults; a Trip's own orgFee*
// Override columns take priority when set. Never exposed to customers —
// only the resulting commercial total is shown at checkout.
// ---------------------------------------------------------------------
model OrganizationFeeConfig {
  id String @id @default("default")

  // TICKET_ONLY: flat fee per traveler regardless of party size.
  feeTicketOnly Float @default(49)

  // TICKET_HOTEL / TICKET_HOTEL_FLIGHT: JSON array of
  // { minParty, maxParty, feePerTraveler }, evaluated in order.
  feeHotelTiers       String @default("[{\"minParty\":1,\"maxParty\":2,\"feePerTraveler\":99},{\"minParty\":3,\"maxParty\":4,\"feePerTraveler\":94},{\"minParty\":5,\"maxParty\":6,\"feePerTraveler\":89},{\"minParty\":7,\"maxParty\":10,\"feePerTraveler\":84}]")
  feeHotelFlightTiers String @default("[{\"minParty\":1,\"maxParty\":2,\"feePerTraveler\":159},{\"minParty\":3,\"maxParty\":4,\"feePerTraveler\":149},{\"minParty\":5,\"maxParty\":6,\"feePerTraveler\":139},{\"minParty\":7,\"maxParty\":10,\"feePerTraveler\":129}]")

  additionalMatchFee Float @default(25) // per traveler, per additional match beyond the first

  // JSON map of PaymentMethod -> internal cost fraction/flat fee, e.g.
  // {"card":0,"bizum":0,"klarna":0.015,"paypal":0.034}. Internal-only cost,
  // never surfaced to the customer as a surcharge.
  paymentMethodFees String @default("{}")

  pricingBuffer          Float @default(0) // flat amount added on top of cost+fee before rounding
  minimumEstimatedProfit Float @default(0) // Admin warning threshold, per booking

  // Explicitly-labeled-as-estimate optional tax preview — never a real
  // accounting/tax engine.
  taxEstimateEnabled Boolean @default(false)
  taxEstimateRate    Float   @default(0)

  updatedAt DateTime @updatedAt
}

model TripOrigin {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city   String
  order  Int    @default(0)
}

model TripPlanningDay {
  id          String @id @default(cuid())
  tripId      String
  trip        Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title       String // e.g. "Viernes"
  description String
  icon        String @default("")
  order       Int    @default(0)
}

model TripActivity {
  id          String @id @default(cuid())
  tripId      String
  trip        Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title       String
  description String @default("")
  order       Int    @default(0)
}

model TripInclusion {
  id       String  @id @default(cuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  text     String
  included Boolean @default(true)
  order    Int     @default(0)
}

// Flat, admin-editable checklist shown in "Mi Viaje" — documentation
// reminders, dress code, meeting point, what to bring, etc. Deliberately
// simple (no categorization) so Admin never needs code to add an item.
model TripRequirement {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  text   String
  order  Int    @default(0)
}

model TripFaq {
  id       String @id @default(cuid())
  tripId   String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  question String
  answer   String
  order    Int    @default(0)
}

// Global FAQ shown on /faq (independent of any single trip).
model Faq {
  id       String  @id @default(cuid())
  // Groups the general FAQ page into scannable sections (e.g. "Antes de
  // reservar", "Vuelos") — "" means uncategorized, rendered in its own
  // catch-all group rather than hidden.
  category String  @default("")
  question String
  answer   String
  order    Int     @default(0)
  active   Boolean @default(true)
}

enum LeadType {
  notify
  waitlist
  general // "Entérate antes que nadie" home capture — not tied to one trip
}

model Lead {
  id        String   @id @default(cuid())
  tripId    String?
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type      LeadType
  name      String   @default("")
  email     String
  city      String   @default("")
  consent   Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum BookingStatus {
  pending_payment
  confirmed
  cancellation_requested
  cancelled
  refund_pending
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentProviderKind {
  demo
  stripe
  paypal
}

model Booking {
  id        String @id @default(cuid())
  reference String @unique // human-friendly booking reference

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Restrict)

  buyerFirstName String
  buyerLastName  String
  buyerEmail     String
  buyerPhone     String
  originCity     String
  billingAddress String @default("")

  travelersCount Int
  singleRooms    Int @default(0)

  totalPrice Float
  currency   String @default("EUR")

  paymentProvider PaymentProviderKind @default(demo)
  paymentStatus   PaymentStatus       @default(pending)
  bookingStatus   BookingStatus       @default(pending_payment)

  accessToken String @unique // used for "Mi Viaje" magic-link access (demo: shown directly)

  internalNotes String @default("")

  // Set by Admin only, when a specific service on this booking genuinely
  // needs one more piece of information that wasn't known/required at
  // checkout time. Empty by default — a brand-new booking must never show
  // a "missing data" banner in Mi Viaje just because it's new.
  additionalDataRequestNote String @default("")

  hasReceivedPassport Boolean @default(false)
  passportStatus      String  @default("pending") // pending | prepared | sent

  // A_TU_AIRE only — null/0 on every legacy and GROUP_CDF booking, which
  // keep using the trip-level bundled price as before.
  packageType  PackageType?
  partySize    Int?
  ticketCount  Int?
  hostSelected Boolean      @default(false)
  hostCount    Int          @default(0)

  // Frozen JSON snapshots of the hotel/flight offers and price breakdown
  // actually purchased, captured at final revalidation — so a later change
  // in mock provider data never rewrites what the customer already bought.
  // hotelSelectionSnapshot includes checkIn/checkOut (not just nights) so
  // Mi Viaje never has to re-derive dates from the Event's current
  // schedule — a later Event change must never silently move a hotel stay
  // the customer already booked.
  hotelSelectionSnapshot  String @default("")
  flightSelectionSnapshot String @default("")
  priceBreakdownSnapshot  String @default("")

  // Frozen room assignment ({type, travelerIndices}[], travelerIndices
  // matching Traveler.order) computed once at booking time from the exact
  // same pure computeRequiredRoomMix + assignTravelersToRooms the checkout
  // used — so a later change to that business rule can never reshuffle a
  // room mix the customer already bought. "" when no hotel was purchased.
  roomingSnapshot String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  travelers       Traveler[]
  changeRequests  ChangeRequest[]
  emailLogs       EmailLog[]
  documents       BookingDocument[]
  updates         BookingUpdate[]
  actions         BookingAction[]
  checkoutAttempt CheckoutAttempt?
}

enum RoomPreference {
  share_with_group
  share_same_sex
  single
}

model Traveler {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  birthDate DateTime?

  // Origin belongs to each traveler, not the buyer — a single booking can
  // mix travelers departing from different cities (see checkout §15).
  originCity String @default("")

  roomPreference  RoomPreference @default(share_with_group)
  roomPartnerName String         @default("")

  // Data captured during checkout when the trip requires it (see
  // Trip.requiredTravelerFields) — no longer a post-purchase "Mi Viaje"
  // checklist for a new booking, though the fields remain editable there
  // for corrections.
  nationality           String    @default("")
  sex                   String    @default("")
  docType               String    @default("") // dni | passport
  docNumber             String    @default("")
  docExpiry             DateTime?
  docCountry            String    @default("")
  phone                 String    @default("")
  emergencyContactName  String    @default("")
  emergencyContactPhone String    @default("")

  // Fase 2 — carried through from CheckoutAttemptTraveler at FINALIZING
  // (see finalize.ts) for modalities with a flight: Duffel's own
  // vocabulary (title: mr/mrs/ms, gender: m/f) plus a per-traveler email,
  // kept ready for the future real Order without a further migration.
  // "" for modalities without a flight, same optional-with-default
  // convention as every other field here.
  title  String @default("")
  gender String @default("")
  email  String @default("")

  // A_TU_AIRE only — tickets can be fewer than travelers (§161), so each
  // traveler tracks whether they're one of the assigned ticket-holders.
  hasTicket     Boolean @default(true)
  originAirport String  @default("")

  // Position within the booking's traveler list at checkout time (0-based).
  // Mi Viaje's room breakdown is reconstructed by re-running the same pure
  // assignTravelersToRooms(partySize, roomMix) the checkout used — which
  // fills rooms strictly in list order — so this field is what lets that
  // reconstruction land on the exact same room assignment shown at
  // checkout, without ever inventing or re-deciding who shares a room.
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------
// Checkout saga foundation (Fase 1) — CheckoutAttempt is the persistent
// root identity of a real-money checkout in progress, independent of
// Booking. Booking is created only once, at finalization (see
// finalizeConfirmedCheckoutAttempt in src/lib/checkout-saga/finalize.ts) —
// never during DRAFT/REVALIDATING/FULFILLING, so Mi Viaje/Admin can never
// show an incomplete operation as a real reservation. Nothing here is
// wired into the live A_TU_AIRE checkout yet; createAtuAireBooking and the
// mock providers are untouched. See docs/CHECKOUT_SAGA.md — no, there is
// no such doc yet; the design rationale lives in this session's own
// architecture report/addenda, not duplicated here.
// ---------------------------------------------------------------------

enum CheckoutAttemptStatus {
  draft
  revalidating
  ready_to_pay
  payment_authorizing
  payment_authorized
  fulfilling
  payment_capturing
  finalizing
  confirmed
  compensating
  recovery_required
  failed
  cancelled
}

enum TicketComponentStatus {
  not_started
  held
  confirmed
  released
  expired
}

// Nullable on CheckoutAttempt when this modality has no hotel at all —
// null IS the "not applicable" signal; there is no separate enum value
// for it, so nothing ever has to fake a status for a component that
// doesn't exist on this attempt.
enum HotelComponentStatus {
  validated
  prebooked
  booking
  confirmed
  unknown
  failed
  cancelling
  cancelled
}

// Same nullable convention as HotelComponentStatus above.
enum FlightComponentStatus {
  validated
  booking
  confirmed
  unknown
  failed
  cancelling
  cancelled
}

enum PaymentComponentStatus {
  not_started
  authorizing
  authorized
  capturing
  captured
  unknown
  voiding
  voided
  failed
}

enum TicketHoldStatus {
  held
  confirmed
  released
  expired
}

enum CheckoutAttemptEventType {
  checkout_created
  state_changed
  ticket_hold_created
  ticket_hold_released
  ticket_hold_expired
  ticket_hold_confirmed
  finalization_started
  finalization_completed
  finalization_failed

  // Fase 2 — the prepareCheckoutAttempt saga steps (see
  // src/lib/checkout-saga/prepareCheckoutAttempt.ts). Sanitized only —
  // never traveler PII, never a raw provider payload.
  travelers_validated
  quote_revalidation_started
  ticket_validated
  hotel_prebook_confirmed
  flight_revalidated
  quote_snapshot_created
}

model CheckoutAttempt {
  id String @id @default(cuid())

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Restrict)

  // Mirrors Booking.packageType/partySize (A_TU_AIRE) — known from the
  // moment the attempt is created, never inferred later.
  packageType PackageType
  partySize   Int

  status CheckoutAttemptStatus @default(draft)

  ticketStatus  TicketComponentStatus  @default(not_started)
  hotelStatus   HotelComponentStatus?
  flightStatus  FlightComponentStatus?
  paymentStatus PaymentComponentStatus @default(not_started)

  // Congelado en REVALIDATING (see src/lib/checkout-saga/finalQuoteSnapshot.ts).
  // "" hasta que existe — mismo convenio que los *Snapshot de Booking.
  finalQuoteSnapshot String @default("")

  // Fase 2.5 §5/§6 — persisted server-side in REVALIDATING, alongside
  // travelers, BEFORE any Booking exists — the single source of truth
  // finalizeConfirmedCheckoutAttempt() reads at FINALIZING (no external
  // caller input anymore). Plain fields directly on CheckoutAttempt
  // rather than a separate CheckoutAttemptBuyer table: buyer is always
  // exactly 1:1 with the attempt (never multiple), so a whole extra
  // table would just be a second place to keep in sync for no relational
  // benefit — same reasoning as Fase 1's decision not to add a redundant
  // Booking<->TicketOffer table. Mirrors Booking's own buyer* field
  // names 1:1 for a trivial copy at FINALIZING.
  buyerFirstName      String @default("")
  buyerLastName       String @default("")
  buyerEmail          String @default("")
  buyerPhone          String @default("")
  buyerOriginCity     String @default("")
  buyerBillingAddress String @default("")

  // Fase 2.6 §3 — the ISO country code the traveler is flying FROM
  // ("¿Desde qué país viajas?"), persisted because it's part of the
  // configuration that was revalidated/quoted, same as buyer/travelers.
  // Deliberately NOT the same concept as CheckoutAttemptTraveler.nationality
  // (a document/identity fact, collected per traveler, unrelated to where
  // this trip departs from) — an Italian resident in Barcelona travels
  // FROM Spain regardless of their nationality, and a Spaniard traveling
  // from Argentina does not. isFlightPackageEligible() (countries.ts) is
  // driven ONLY by this field — never by nationality or any Nuitee
  // "guestNationality" value.
  travelOriginCountry String @default("")

  // Not PII — an operational choice, not yet collected from a real
  // payment-method UI in this phase (no Stripe integration exists yet).
  // "demo" signals "no real payment provider chosen" until Fase 3 wires
  // an actual selector; finalize.ts reads this instead of accepting it
  // as a caller argument.
  paymentProviderChoice PaymentProviderKind @default(demo)

  // Fase 2.5 §22 — opaque, unguessable lookup for the new /reservar-real
  // flow to reconstruct READY_TO_PAY after a refresh, without trusting
  // the raw (sequential-feeling, if still a cuid) id for public exposure —
  // same "public reference vs. secret token" split already established
  // for Booking.accessToken/Mi Viaje. Generated once at creation.
  accessToken String @unique @default("")

  bookingId String?  @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])

  // Opaque provider reference strings — populated in a future phase once
  // Stripe/Nuitee/Duffel are actually wired. "" until then.
  paymentProviderReference String @default("")
  hotelProviderReference   String @default("")
  flightProviderReference  String @default("")

  failureCode String @default("")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  // Fase 2 §22 — the earliest of every real, known external/internal
  // expiration bounding this attempt (our own TicketHold.expiresAt; the
  // Duffel round-trip offer's expiresAt when a flight is part of the
  // quote). Never invented — see src/lib/checkout-saga/quoteValidity.ts.
  // Null until READY_TO_PAY computes it; Nuitee never contributes a bound
  // here because it doesn't provide one (see finalQuoteSnapshot.ts).
  latestSafePaymentAt DateTime?

  ticketHolds TicketHold[]
  events      CheckoutAttemptEvent[]
  travelers   CheckoutAttemptTraveler[]
}

// Fase 2 §6 — persists the travelers collected during REVALIDATING,
// BEFORE any Booking exists (Booking must never exist before CONFIRMED —
// see finalize.ts). Copied into Booking.Traveler at FINALIZING
// (finalizeConfirmedCheckoutAttempt reads FROM here now, never from an
// arbitrary caller-supplied list — a single source of truth for
// pre-payment traveler PII). Field list mirrors Traveler's own optional-
// with-default convention; title/gender/email/phone are additionally
// enforced (dynamically, not via NOT NULL) as required whenever the
// modality includes a flight — see travelerValidation.ts.
model CheckoutAttemptTraveler {
  id String @id @default(cuid())

  checkoutAttemptId String
  checkoutAttempt   CheckoutAttempt @relation(fields: [checkoutAttemptId], references: [id], onDelete: Cascade)

  order Int @default(0)

  firstName String
  lastName  String
  birthDate DateTime?

  // Duffel's own vocabulary — see FlightOrderPassenger in
  // src/lib/providers/flights/duffel/types.ts. "" until a flight modality
  // requires them.
  title  String @default("") // "mr" | "mrs" | "ms"
  gender String @default("") // "m" | "f"
  email  String @default("") // per-traveler; may equal the buyer's email — no uniqueness enforced
  phone  String @default("") // E.164 once validated — see src/lib/checkout-saga/phone.ts

  nationality           String    @default("")
  docType               String    @default("")
  docNumber             String    @default("")
  docExpiry             DateTime?
  docCountry            String    @default("")
  emergencyContactName  String    @default("")
  emergencyContactPhone String    @default("")
  originAirport         String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([checkoutAttemptId, order])
}

// Belongs to exactly one CheckoutAttempt, always — never a "loose" hold.
// One row per (checkoutAttemptId, ticketOfferId): quantity carries the
// count, so a party needing several units of the same TicketOffer never
// needs several hold rows for it.
model TicketHold {
  id String @id @default(cuid())

  checkoutAttemptId String
  checkoutAttempt   CheckoutAttempt @relation(fields: [checkoutAttemptId], references: [id], onDelete: Cascade)

  ticketOfferId String
  ticketOffer   TicketOffer @relation(fields: [ticketOfferId], references: [id], onDelete: Restrict)

  quantity Int
  status   TicketHoldStatus @default(held)

  // Only meaningful while status = held — see releaseExpiredTicketHolds();
  // a CONFIRMED hold is never expired regardless of this value.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([checkoutAttemptId, ticketOfferId])
}

// Append-only event log for one CheckoutAttempt — NOT event sourcing;
// CheckoutAttempt's own columns remain the live state. This is for
// auditoría/recovery/debugging only. sanitizedDetail must never carry a
// raw provider payload, a secret, or traveler PII — small JSON only.
model CheckoutAttemptEvent {
  id String @id @default(cuid())

  checkoutAttemptId String
  checkoutAttempt   CheckoutAttempt @relation(fields: [checkoutAttemptId], references: [id], onDelete: Cascade)

  type CheckoutAttemptEventType

  providerReference String @default("")
  sanitizedDetail   String @default("")

  createdAt DateTime @default(now())
}

// Fase 2.6 §2 — server-side home for one Duffel round-trip Offer
// Request's results, keyed by an opaque id the browser can hold onto
// without ever seeing offerRequestId or passengerIds directly. Created
// once per (trip, partySize, origin) search — before any CheckoutAttempt
// exists, since the customer may browse several origins before choosing
// one modality/hotel/traveler combination. `offersJson` is a compact,
// non-PII array of {offerId, totalAmount, currency, outbound, return,
// commercialProduct} — everything prepareCheckoutAttempt needs to
// revalidate a client-selected offerId against what this search actually
// returned, without re-fetching Duffel or trusting the client's own copy.
// No FK to CheckoutAttempt: a session may be searched, browsed, and
// abandoned without ever producing one, and one search can in principle
// back more than one attempt (e.g. the customer changes their mind and
// restarts CONFIGURACIÓN) — a straight foreign key would force a 1:1 that
// doesn't hold. Deliberately no cleanup job in this phase (MVP) — an
// expired row is simply rejected by prepareCheckoutAttempt at read time.
model FlightSearchSession {
  id String @id @default(cuid())

  tripId          String
  partySize       Int
  originIata      String
  destinationIata String
  outboundDate    String // yyyy-mm-dd
  returnDate      String // yyyy-mm-dd

  offerRequestId String
  // JSON string[] — Duffel's own passenger placeholder ids for this Offer
  // Request. Never sent to the browser; read server-side only, at
  // prepareCheckoutAttempt time, from this row.
  passengerIds   String

  // JSON StoredFlightOffer[] — see real-checkout-search.ts's own type.
  offersJson String

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([tripId, originIata, partySize])
}

enum BookingDocumentType {
  ticket
  hotel
  flight
  other
}

// A single, honest state per document — never invented per-provider
// tracking. "pending": not issued/confirmed yet. "available": ready to
// view, nothing to download yet (matches computeQuote's "no fake PDFs"
// rule). "delivered": the actual file/URL has been attached and sent.
// "action_required": something on this document needs the customer's
// attention (see ChangeRequest for how they respond).
enum BookingDocumentStatus {
  pending
  available
  delivered
  action_required
}

// Mi Viaje's "Documentación" block (§23/§24) reads these rows — one per
// ticket/Event, plus one each for hotel/flight when contracted. Doubles as
// the backing for "Tus entradas"/"Tus vuelos"'s own status line, so a
// ticket's state is never represented two different ways in two different
// places. fileUrl stays "" until a real document exists — Mi Viaje must
// never fabricate a downloadable file.
model BookingDocument {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type    BookingDocumentType
  // Ties a `ticket` document to one specific Event, for multi-match
  // bookings — "" for hotel/flight/other (one per booking, not per Event).
  eventId String              @default("")
  label   String              @default("")

  status  BookingDocumentStatus @default(pending)
  fileUrl String                @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mi Viaje's "Actualizaciones" timeline (§20/§21/§22) — an append-only log
// a human (Admin, in a future block) or a real trigger writes to; nothing
// here is ever auto-generated from a template. No rows for a booking means
// literally nothing to report yet, which Mi Viaje shows as a plain "No hay
// novedades", never an invented entry.
model BookingUpdate {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  title   String
  message String @default("")

  createdAt DateTime @default(now())
}

enum BookingActionType {
  hotel_checkin
  flight_checkin
  data_correction
  change_review
  document
  other
}

enum BookingActionStatus {
  pending
  completed
}

// Mi Viaje's "Acciones necesarias" block (correction microblock §6-11) —
// only real, persisted actions ever appear here: an explicit row here, a
// BookingDocument already marked action_required, or Booking's own
// admin-set additionalDataRequestNote. Never auto-generated from Event
// data or heuristics, and never seeded in production by default — only
// dev/demo seed data creates one to preview the UI.
model BookingAction {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type        BookingActionType
  title       String
  description String              @default("")
  status      BookingActionStatus @default(pending)

  actionUrl String    @default("")
  dueAt     DateTime?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

enum ChangeRequestType {
  name_change
  important_change
  cancellation
}

enum ChangeRequestStatus {
  requested
  in_review
  approved
  rejected
  completed
}

model ChangeRequest {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type            ChangeRequestType
  description     String
  status          ChangeRequestStatus @default(requested)
  resolutionNotes String              @default("")
  cost            Float? // real cost if applicable — never invented automatically

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------
// Transactional emails — fully editable from Admin so no code change is
// needed to update copy, timing or on/off state.
// ---------------------------------------------------------------------
model EmailTemplate {
  id               String  @id @default(cuid())
  key              String  @unique // e.g. "booking_confirmed"
  name             String
  description      String  @default("")
  subject          String
  body             String // supports {{variable}} placeholders, see docs/EMAILS.md
  active           Boolean @default(false)
  // Offset in days relative to the trip's departure/return date, or null
  // for "immediate" (sent right after the triggering event, e.g. booking)
  // or "event" (sent explicitly from Admin at the moment a real
  // BookingAction/BookingUpdate is created — never swept by a calendar).
  timingDaysOffset Int?
  timingReference  String  @default("immediate") // immediate | event | booking_plus_1 | before_departure | after_return

  // Retired templates (e.g. the old GROUP_CDF-era sequence) are kept for
  // history rather than deleted, but hidden from Admin's normal template
  // list and excluded from any future sending — see docs/EMAILS.md.
  archived Boolean @default(false)

  updatedAt DateTime @updatedAt
}

enum EmailMode {
  demo
  real
}

model EmailLog {
  id          String    @id @default(cuid())
  templateKey String
  to          String
  subject     String
  body        String
  mode        EmailMode @default(demo)
  sentAt      DateTime  @default(now())

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
}

// Note: admin auth uses a stateless signed cookie (see src/lib/auth/admin.ts)
// rather than a DB-backed session, so it can be checked in Next.js
// middleware (edge runtime, no Prisma access) without an extra round trip.
// Fine for a single small internal team in V1; documented upgrade path to
// Supabase Auth in docs/DEPLOYMENT.md.
